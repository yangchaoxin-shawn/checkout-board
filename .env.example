# 每日作战打卡看板 — 环境变量配置
#
# 使用方式：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改 CHECKIN_PASSWORD 为你的门禁密码
#   3. docker compose up -d
#
# 如需修改端口，编辑 API_PORT 即可。

# ── 必填 ───────────────────────────────────────────

# 前端门禁密码（所有成员通过此密码进入打卡页面）
CHECKIN_PASSWORD=YourStrongPasswordHere

# Token 签名密钥（随机字符串，建议 32 位以上）
# 生成方式：在终端执行  openssl rand -hex 32
CHECKIN_SECRET=YourRandomSecretChangeMePlease


# ── 可选 ───────────────────────────────────────────

# 后端 API 端口（默认 8080，外网 nginx 反向代理与此对应）
# API_PORT=8080
